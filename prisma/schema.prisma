// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  phoneNumber   String
  role          String   @default("USER") // USER or ADMIN
  status        String   @default("ACTIVE") // ACTIVE or BLOCKED
  password      String
  emailNotificationsEnabled Boolean @default(true)
  emailVerified DateTime?
  
  // Referral System Fields
  referralCode  String?  @unique
  referredBy    Int?
  referrer      User?    @relation("Referrals", fields: [referredBy], references: [id])
  referrals     User[]   @relation("Referrals")
  rewardBalance Float    @default(0.0)
  completedTradesCount Int @default(0)
  
  // Login Trackers
  lastLoginAt   DateTime?
  lastIp        String?
  lastDevice    String?
  
  trades        Trade[]
  messages      Message[] @relation("UserMessages")
  redemptions   RewardRedemption[]
  accounts      Account[]
  sessions      Session[]
  loginEvents   LoginEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Custom tracking fields
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  lastActive   DateTime @default(now())
}

model RegistrationOTP {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetOTP {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Trade {
  id                Int       @id @default(autoincrement())
  tradeId           String    @unique // e.g., GC-2026-0001
  batchId           String?   // For grouping multiple cards submitted together
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  fullName          String?

  cardBrand         String
  cardCountry       String
  cardType          String    // Physical, E-code
  faceValue         Float
  currency          String
  calculatedPayout  Float?    // The expected payout when submitted based on the active rate
  cardCode          String    // Raw code, accessible only to admin
  serialNumber      String?
  cardCodeHash      String    // SHA-256 hash for duplicate detection
  status            String    @default("PENDING") // PENDING, UNDER_REVIEW, PAID, REJECTED, COMPLETED
  
  payoutMethod      PayoutMethod @default(MOBILE_MONEY)
  payoutNetwork     String    // MTN, Telecel
  payoutPhoneNumber String
  payoutAccountName String?   // Account name attached to the mobile money number

  // crypto payout fields (nullable for non-crypto trades)
  cryptoCoin           CryptoCoin?
  cryptoNetwork        CryptoNetwork?
  cryptoExchange       CryptoExchange?
  cryptoReceiverIdType CryptoReceiverIdType?
  cryptoReceiverId     String?
  cryptoTxHash         String?
  cryptoTxNote         String?

  imageUrls         String    @default("[]") // JSON string of upload paths
  paymentReference  String?
  paidAt            DateTime?
  adminNotes        String?
  messages          Message[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Settings {
  id                      Int      @id @default(autoincrement())
  siteName                String   @default("Omor Biggy Gift Card Trading Center")
  contactEmail            String   @default("support@omorbiggy.com")
  whatsappNumber          String   @default("")
  landingPageIntroText    String   @default("Sell your gift cards for instant cash payouts via MTN & Telecel.")
  faqContent              String   @default("[]") // JSON string of FAQs
  referralBonusPercentage Float    @default(1.5) // Percentage of the referred user's first trade
  rewardPointsToGhs       Float    @default(100.0) // How much 100 Reward Points is worth in GHS
  usdtExchangeRate        Float    @default(15.0) // How much GHS is 1 USDT currently
}

model CardRate {
  id          Int      @id @default(autoincrement())
  cardBrand   String   // e.g., Apple/iTunes
  cardCountry String   // e.g., US
  cardType    String   @default("Physical") // Physical, E-code
  rate        Float    // e.g., 10.5 (GHS per USD)
  publicRate  Float?   // Optional: Different rate for public display
  updatedAt   DateTime @updatedAt

  @@unique([cardBrand, cardCountry, cardType])
}

model Message {
  id        Int      @id @default(autoincrement())
  tradeId   Int
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("UserMessages", fields: [senderId], references: [id])
  content   String
  isRead    Boolean  @default(false)
  readAt    DateTime?
  fileUrl   String?
  fileType  String? // IMAGE or FILE
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RewardRedemption {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  pointsRedeemed Float
  status        String   @default("PENDING") // PENDING, PAID, REJECTED
  payoutMethod  String?  // e.g., "Add to next trade payout", "Mobile Money"
  payoutDetails String?  // Optional info if Mobile Money was chosen
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model StatusUpdate {
  id        Int      @id @default(autoincrement())
  imageUrl  String?
  message   String   @db.Text
  views     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginEvent {
  id              Int         @id @default(autoincrement())
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id])
  emailOrUsername String
  portal          LoginPortal
  success         Boolean
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())
}

enum LoginPortal {
  USER
  ADMIN
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CRYPTO
}

enum CryptoCoin {
  USDT
  BTC
}

enum CryptoNetwork {
  TRC20
  ERC20
  BTC_MAINNET
}

enum CryptoExchange {
  NOONES
  BINANCE
  OKX
  BYBIT
  KUCOIN
  OTHER
}

enum CryptoReceiverIdType {
  WALLET_ADDRESS
  EXCHANGE_ID
}

